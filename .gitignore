# Segredos — nunca versionar. O .env.example é a exceção: documenta as variáveis sem os valores.
.env
.env.*
!.env.example

# Python (api/) — ambiente, caches e relatórios, todos recriáveis. O uv.lock é versionado.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor — rede de segurança; as regras da sua máquina ficam no gitignore global.
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db
